# MIT License - Copyright (c) 2026 Destroyer
# AUR PKGBUILD for disc — Modern DSK image manipulation tool for Amstrad CPC
#
# To publish this package on AUR:
#   1. Create an AUR account at https://aur.archlinux.org
#   2. Clone the AUR repository: git clone ssh://aur@aur.archlinux.org/disc-image-studio.git
#   3. Copy this PKGBUILD into the cloned directory
#   4. Run: makepkg --printsrcinfo > .SRCINFO
#   5. Commit and push: git add PKGBUILD .SRCINFO && git commit -m "Initial release" && git push
#
# Replace GITHUB_OWNER with the actual GitHub username/organization.
# Update sha256sums on every release with: updpkgsums

# Maintainer: Destroyer <MAINTAINER_EMAIL>
pkgname=disc-image-studio
pkgver=0.1.0
pkgrel=1
pkgdesc="Modern DSK image manipulation tool for Amstrad CPC"
arch=("x86_64" "aarch64")
url="https://github.com/GITHUB_OWNER/disc-image-studio"
license=("MIT")
makedepends=("rust" "cargo")
provides=("disc")
conflicts=("disc")
source=("$pkgname-$pkgver.tar.gz::https://github.com/GITHUB_OWNER/disc-image-studio/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=("REPLACE_WITH_SHA256_OF_SOURCE_TARBALL")

prepare() {
    cd "$srcdir/$pkgname-$pkgver/disc"
    # Pre-fetch Cargo dependencies (respects CARGO_HOME cache)
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "$srcdir/$pkgname-$pkgver/disc"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="target"
    cargo build --release --frozen
}

check() {
    cd "$srcdir/$pkgname-$pkgver/disc"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --release --frozen
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # Binary
    install -Dm755 "disc/target/release/disc" "$pkgdir/usr/bin/disc"

    # License
    install -Dm644 "disc/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || \
    install -Dm644 "LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true

    # Man pages (generated by the binary itself)
    local mandir="$srcdir/man"
    mkdir -p "$mandir"
    "$pkgdir/usr/bin/disc" --no-color mangen "$mandir"
    for f in "$mandir"/*.1; do
        install -Dm644 "$f" "$pkgdir/usr/share/man/man1/$(basename "$f")"
    done

    # Shell completions
    local compdir="$srcdir/completions"
    mkdir -p "$compdir"

    "$pkgdir/usr/bin/disc" --no-color completions bash > "$compdir/disc.bash"
    install -Dm644 "$compdir/disc.bash" \
        "$pkgdir/usr/share/bash-completion/completions/disc"

    "$pkgdir/usr/bin/disc" --no-color completions zsh > "$compdir/_disc"
    install -Dm644 "$compdir/_disc" \
        "$pkgdir/usr/share/zsh/site-functions/_disc"

    "$pkgdir/usr/bin/disc" --no-color completions fish > "$compdir/disc.fish"
    install -Dm644 "$compdir/disc.fish" \
        "$pkgdir/usr/share/fish/vendor_completions.d/disc.fish"
}
